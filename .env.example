PORT=8888
LOG_LEVEL=info

POSTGRES_DB=talk2scale
POSTGRES_USER=talk2scale
POSTGRES_PASSWORD=talk2scale_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# LLM: ollama (default, local) or anthropic. Label scan and dictation share the same model.
LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2-vision
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-4-5-haiku
